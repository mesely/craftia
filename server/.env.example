NODE_ENV=development
PORT=3000

# mock = in-memory sample data (no database needed)
# mongo = MongoDB through MONGODB_URI
DATA_SOURCE=mock

MONGODB_URI=

# Signs session tokens (>= 32 chars). Required in production: openssl rand -hex 32
AUTH_SECRET=

# Firebase Authentication (Google, Apple, SMS). Leave empty to keep these sign-ins switched off.
FIREBASE_PROJECT_ID=
# google,apple,phone (default: all three once FIREBASE_PROJECT_ID is set)
AUTH_METHODS=
DATABASE_NAME=usta_db
